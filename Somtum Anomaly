local function GetDrainPrompt()
    local success, result = pcall(function()
        return Workspace.Start.Drain.Scripted.ProximityPosition.ProximityPrompt
    end)
    if success and result then return result end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent.Name:find("Drain") then
            return obj
        end
    end
    return nil
end

--// ========== 🔧 หาน้ำแบบไม่ต้องวาร์ป ==========

local function GetWaterInfo()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil, nil end

    local charPos = hrp.Position

    -- 1. หาโฟลเดอร์ Water ใน Start
    local startFolder = Workspace:FindFirstChild("Start")
    if startFolder then
        local waterFolder = startFolder:FindFirstChild("Water")
        if waterFolder then
            -- หา Part ที่แทนระดับน้ำปัจจุบัน (Top หรือ Part อื่น)
            local waterPart = waterFolder:FindFirstChild("Top")
            if not waterPart or not waterPart:IsA("BasePart") then
                for _, child in ipairs(waterFolder:GetChildren()) do
                    if child:IsA("BasePart") then
                        waterPart = child
                        break
                    end
                end
            end
            if waterPart and waterPart:IsA("BasePart") then
                return waterPart, waterPart.Position.Y
            end
        end
    end

    -- 2. Raycast ลงจากตัวละครเพื่อหาน้ำจริง
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Whitelist
    local waterParts = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:find("Water") or obj.Name:find("Lake") or obj.Name:find("River") or obj.Name:find("Sea")) then
            table.insert(waterParts, obj)
        end
    end
    if #waterParts > 0 then
        rayParams.FilterDescendantsInstances = waterParts
        local rayResult = Workspace:Raycast(charPos + Vector3.new(0, 50, 0), Vector3.new(0, -200, 0), rayParams)
        if rayResult and rayResult.Instance then
            return rayResult.Instance, rayResult.Position.Y
        end
    end

    -- 3. หา Part น้ำใกล้สุดในแนวแกน Y
    local bestPart = nil
    local bestY = nil
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:find("Water") or obj.Name:find("Lake")) then
            if not bestY or math.abs(obj.Position.Y - charPos.Y) < math.abs(bestY - charPos.Y) then
                bestY = obj.Position.Y
                bestPart = obj
            end
        end
    end
    return bestPart, bestY
end

--// ========== หา Bucket ==========

local function GetCurrentBucket()
    local char = player.Character
    if not char then return nil end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool:FindFirstChild("WaterLevels") or tool.Name:find("Bucket")) then
            return tool
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool:FindFirstChild("WaterLevels") or tool.Name:find("Bucket")) then
                return tool
            end
        end
    end
    return nil
end

local function GetWaterPercent(bucket)
    if not bucket then return 0, 0 end
    local waterLevels = bucket:FindFirstChild("WaterLevels")
    if not waterLevels then return 0, 0 end
    local filled, total = 0, 0
    for _, part in ipairs(waterLevels:GetChildren()) do
        if part:IsA("BasePart") then
            total += 1
            if part.Transparency < 1 then filled += 1 end
        end
    end
    if total == 0 then return 0, 0 end
    return math.floor((filled / total) * 100), total
end

--// ========== 🔧 เก็บน้ำจากด้านบน ==========

local function CollectWaterRemote()
    local remote = GetBucketRemote()
    if not remote then
        if Config.DebugMode then warn("❌ ไม่พบ Remote VDT_Bucket.Used") end
        return false
    end

    local char = player.Character
    if not char then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local waterPart, waterY = GetWaterInfo()
    if not waterPart or not waterY then
        if Config.DebugMode then warn("❌ ไม่พบน้ำ") end
        return false
    end

    local hrpPos = hrp.Position

    -- 🔑 สำคัญ: ไม่วาร์ป! ใช้ตำแหน่งยืนปัจจุบัน
    -- args[2] = ตำแหน่งตัวละคร (จุดเริ่มต้น Ray)
    -- args[4] = ตำแหน่งที่ตีกับน้ำ (ด้านล่าง)

    local args = {
        [1] = waterPart,
        [2] = hrpPos,                                    -- ตำแหน่งที่ยืนอยู่
        [3] = Vector3.new(0, -1, 0),                     -- ทิศทางลง
        [4] = Vector3.new(hrpPos.X, waterY, hrpPos.Z)    -- จุดที่น้ำจริง
    }

    if Config.DebugMode then
        print(string.format("📤 เก็บน้ำ | ยืนที่ Y:%d | น้ำ Y:%d | ระยะ:%d",
            math.floor(hrpPos.Y),
            math.floor(waterY),
            math.floor(hrpPos.Y - waterY)))
    end

    local success, err = pcall(function()
        remote:FireServer(unpack(args))
    end)

    if Config.DebugMode then
        if success then print("✅ เก็บน้ำสำเร็จ") else warn("❌ เก็บน้ำล้มเหลว:", err) end
    end
    return success
end

local function SellWaterRemote()
    local remote = GetSellRemote()
    local prompt = GetDrainPrompt()
    if not remote or not prompt then return false end
    local success, err = pcall(function()
        remote:FireServer(prompt)
    end)
    if Config.DebugMode then
        if success then print("✅ ขายน้ำสำเร็จ") else warn("❌ ขายน้ำล้มเหลว:", err) end
    end
    return success
end

local function CollectMoneyRemote()
    local remote = GetMoneyRemote()
    local prompt = GetDrainPrompt()
    if not remote or not prompt then return false end
    local success, err = pcall(function()
        remote:FireServer(prompt)
    end)
    if Config.DebugMode then
        if success then print("✅ เก็บเงินสำเร็จ") else warn("❌ เก็บเงินล้มเหลว:", err) end
    end
    return success
end

local function ClearWaterVisual(bucket)
    if not bucket then return end
    local waterLevels = bucket:FindFirstChild("WaterLevels")
    if not waterLevels then return end
    for _, part in ipairs(waterLevels:GetChildren()) do
        if part:IsA("BasePart") then
            TweenService:Create(part, TweenInfo.new(0.3), {Transparency = 1}):Play()
        end
    end
end

--// ========== ระบบ Auto ==========

local function StartAutoCollect()
    if isAutoCollect then return end
    isAutoCollect = true
    collectThread = task.spawn(function()
        while isAutoCollect do
            local bucket = GetCurrentBucket()
            if bucket then
                local percent = GetWaterPercent(bucket)
                if percent < 100 then
                    CollectWaterRemote()
                end
            end
            task.wait(Config.AutoCollectInterval)
        end
    end)
end

local function StopAutoCollect()
    isAutoCollect = false
end

local function StartAutoSell()
    if isAutoSell then return end
    isAutoSell = true
    sellThread = task.spawn(function()
        while isAutoSell do
            local bucket = GetCurrentBucket()
            if bucket then
                local percent = GetWaterPercent(bucket)
                if percent >= Config.SellThreshold then
                    SellWaterRemote()
                    ClearWaterVisual(bucket)
                end
            end
            task.wait(Config.AutoSellInterval)
        end
    end)
end

local function StopAutoSell()
    isAutoSell = false
end

local function StartAutoMoney()
    if isAutoMoney then return end
    isAutoMoney = true
    moneyThread = task.spawn(function()
        while isAutoMoney do
            CollectMoneyRemote()
            task.wait(Config.AutoMoneyInterval)
        end
    end)
end

local function StopAutoMoney()
    isAutoMoney = false
end


local function GetBucketRemote()
    local verdant = ReplicatedStorage:FindFirstChild("VerdantRemotes")
    if verdant then
        local remote = verdant:FindFirstChild("VDT_Bucket.Used")
        if remote then return remote end
    end
    for _, child in ipairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("RemoteEvent") and child.Name:find("Bucket") and child.Name:find("Used") then
            return child
        end
    end
    return nil
end

local function GetSellRemote()
    local verdant = ReplicatedStorage:FindFirstChild("VerdantRemotes")
    if verdant then
        local remote = verdant:FindFirstChild("VDT_Bucket.Poured")
        if remote then return remote end

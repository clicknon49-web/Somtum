            if not cycleIndex then cycleIndex = 1 end
            cycleIndex = cycleIndex % #list + 1
            Config.TargetPickaxe = list[cycleIndex]
            print("🎯 Target Pickaxe: " .. Config.TargetPickaxe)
            UI.UpdateProgress(1, "🎯 Target: " .. Config.TargetPickaxe)
            wait(1)
        end
    end)
end


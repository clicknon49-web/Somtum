-- ============================================
-- CORE FUNCTIONS
-- ============================================

local function getDistance(pos1, pos2)
    return (pos1 - pos2).Magnitude
end

local function isGhost(player)
    if player.Character then
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if humanoid then
            return humanoid.Health == 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead
        end
    end
    return false
end

local function teleportTo(position)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        hrp.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
        task.wait(0.5)
    end
end

local function identifyIngredient(part)
    if part:IsA("BasePart") then
        if part.Color == CONFIG.CHILLI_COLOR then return "chilli" end
        if part.Color == CONFIG.VEGETABLE_COLOR then return "vegetables" end
        if part.Color == CONFIG.FLAVORING_COLOR then return "flavorings" end
        
        local name = part.Name:lower()
        if name:find("chilli") then return "chilli" end
        if name:find("vegetable") then return "vegetables" end
        if name:find("flavor") then return "flavorings" end
        if name:find("papaya") then return "vegetables" end
    end
    return nil
end

local function findNearestIngredient()
    local nearest = nil
    local nearestDistance = CONFIG.AUTOFARM_RANGE
    local playerPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not playerPos then return nil end
    
    for _, ingredient in pairs(ingredientList) do
        if ingredient.Type and ingredient.Position then
            local distance = getDistance(ingredient.Position, playerPos.Position)
            if distance < nearestDistance then
                nearestDistance = distance
                nearest = ingredient
            end
        end
    end
    return nearest
end

local function farmIngredients()
    local currentTime = tick()
    if currentTime - lastFarmTime < FARM_COOLDOWN then return end
    lastFarmTime = currentTime
    
    ingredientList = {}
    
    local function searchFolder(folder)
        if not folder then return end
        for _, item in pairs(folder:GetDescendants()) do
            if item:IsA("BasePart") then
                local type = identifyIngredient(item)
                if type then
                    table.insert(ingredientList, {
                        Type = type,
                        Instance = item,
                        Position = item.Position
                    })
                end
            end
        end
    end
    
    searchFolder(Workspace)
    if Workspace:FindFirstChild("Tools") then
        searchFolder(Workspace:FindFirstChild("Tools"))
    end
    
    local nearest = findNearestIngredient()
    if nearest then
        teleportTo(nearest.Position)
        task.wait(0.5)
        
        if inventory[nearest.Type] and inventory[nearest.Type] < CONFIG.MAX_INVENTORY then
            inventory[nearest.Type] = inventory[nearest.Type] + 1
            if nearest.Instance and nearest.Instance.Parent then
                nearest.Instance:Destroy()
            end
        end
    end
end

local function craftSomtum()
    if inventory.chilli >= 1 and inventory.vegetables >= 2 and inventory.flavorings >= 1 then
        inventory.chilli = inventory.chilli - 1
        inventory.vegetables = inventory.vegetables - 2
        inventory.flavorings = inventory.flavorings - 1
        inventory.mortar = inventory.mortar + 1
        return true
    end
    return false
end

local function scanForGhosts()
    local currentTime = tick()
    if currentTime - lastScanTime < CONFIG.SCAN_COOLDOWN then return end
    lastScanTime = currentTime
    ghostTargets = {}
    
    if not LocalPlayer.Character then return end
    local playerPos = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not playerPos then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local targetPos = player.Character:FindFirstChild("HumanoidRootPart")
            if targetPos then
                local distance = getDistance(playerPos.Position, targetPos.Position)
                if distance <= CONFIG.GHOST_DETECTION_RANGE then
                    if isGhost(player) then
                        table.insert(ghostTargets, {
                            player = player,
                            distance = distance,
                            position = targetPos.Position
                        })
                    end
                end
            end
        end
    end
end


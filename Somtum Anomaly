        if (btn == collectBtn and not isAutoCollect) or (btn == sellBtn and not isAutoSell) then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55, 55, 75)}):Play()

-- [[ Delta Executor Compatible Auto Farm Script ]]
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- ตัวแปรหลัก
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Remote Events
local remotes = ReplicatedStorage:FindFirstChild("Remotes")
if not remotes then
    warn("Remotes not found! Waiting...")
    remotes = ReplicatedStorage:WaitForChild("Remotes")
end

local digRequest = remotes:FindFirstChild("DigRequest")
local sellRequest = remotes:FindFirstChild("SellRequest")
local upgradeOpen = remotes:FindFirstChild("UpgradeOpen")
local upgradeBuy = remotes:FindFirstChild("UpgradeBuy")
local shopOpen = remotes:FindFirstChild("ShopOpen")
local shopBuy = remotes:FindFirstChild("ShopBuy")
local equipTool = remotes:FindFirstChild("ShopEquip")

-- สถานะ
local isAutoFarming = false
local isAutoSelling = false
local isAutoUpgrading = false
local upgradeIndex = 1
local pickaxeToBuy = "DIAMOND Pickaxe"
local digCooldown = 0.15

-- ฟังก์ชันขุด (ใช้ pcall ป้องกัน Error)
local function Dig()
    if isAutoFarming and character and humanoid and humanoid.Health > 0 and digRequest then
        pcall(function()
            digRequest:FireServer()
        end)
        wait(digCooldown) -- ใช้ wait() แทน task.wait()
    end
end

-- ฟังก์ชันขาย
local function SellItems()
    if isAutoSelling and sellRequest then
        pcall(function()
            sellRequest:FireServer()
        end)
        wait(0.5)
    end
end

-- ฟังก์ชันอัพเกรด
local function Upgrade()
    if not isAutoUpgrading then return end
    
    local upgradeTypes = {"Backpack", "Air", "Pickaxe"}
    local currentType = upgradeTypes[upgradeIndex] or "Backpack"
    
    if upgradeOpen and upgradeBuy then
        pcall(function()
            upgradeOpen:FireServer()
            wait(0.3)
            upgradeBuy:FireServer(currentType, 1) -- อัพเกรดครั้งละ 1 ระดับ
            wait(0.3)
        end)
    end
    
    upgradeIndex = upgradeIndex + 1
    if upgradeIndex > #upgradeTypes then
        upgradeIndex = 1
    end
end

-- ฟังก์ชันซื้อขวาน
local function BuyAndEquipPickaxe(name)
    if shopOpen and shopBuy and equipTool then
        pcall(function()
            shopOpen:FireServer()
            wait(0.3)
            shopBuy:FireServer(name)
            wait(0.3)
            equipTool:FireServer(name)
            wait(0.3)
        end)
        print("✅ Equipped: " .. name)
    end
end

-- ฟังก์ชันหลัก (ใช้ while true แทน task.spawn)
local function AutoLoop()
    while true do
        if character and humanoid and humanoid.Health > 0 then
            if isAutoFarming then Dig() end
            if isAutoSelling then SellItems() end
            if isAutoUpgrading then Upgrade() end
        else
            -- รอเกิดใหม่
            character = player.Character or player.CharacterAdded:Wait()
            humanoid = character:WaitForChild("Humanoid")
            rootPart = character:WaitForChild("HumanoidRootPart")
        end
        wait(0.5) -- ใช้ wait() แทน task.wait()
    end
end

-- คำสั่งเปิด/ปิด (ใช้ pcall ป้องกัน)
local function Toggle(label, stateVar)
    local newState = not getfenv()[stateVar]
    getfenv()[stateVar] = newState
    print(label .. ": " .. tostring(newState))
    return newState
end

-- ปุ่มลัดสำหรับ Delta (ใช้ Touch หรือ Keyboard)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.F then
        isAutoFarming = not isAutoFarming
        print("🌾 Auto Farm: " .. tostring(isAutoFarming))
    elseif input.KeyCode == Enum.KeyCode.G then
        isAutoSelling = not isAutoSelling
        print("💰 Auto Sell: " .. tostring(isAutoSelling))
    elseif input.KeyCode == Enum.KeyCode.H then
        isAutoUpgrading = not isAutoUpgrading
        print("⬆️ Auto Upgrade: " .. tostring(isAutoUpgrading))
    elseif input.KeyCode == Enum.KeyCode.J then
        BuyAndEquipPickaxe(pickaxeToBuy)
    elseif input.KeyCode == Enum.KeyCode.K then
        local list = {"Rusty Scrapper", "Weathered Wood", "Volcano Basalt", "DIAMOND Pickaxe"}
        for i, v in ipairs(list) do
            if v == pickaxeToBuy then
                pickaxeToBuy = list[i % #list + 1]
                break
            end
        end
        print("🎯 Pickaxe: " .. pickaxeToBuy)
    end
end)

-- เริ่มลูป
spawn(AutoLoop) -- ใช้ spawn() แทน task.spawn

-- แสดงคำแนะนำ
print("========================================")
print("🔥 Delta Auto Script Loaded!")
print("F = Toggle Auto Dig/Farm")
print("G = Toggle Auto Sell")
print("H = Toggle Auto Upgrade")
print("J = Buy & Equip Pickaxe")
print("K = Cycle Pickaxe")
print("========================================")

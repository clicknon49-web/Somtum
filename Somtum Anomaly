RunService.RenderStepped:Connect(function()
    if CONFIG.ESP_ENABLED then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if player.Character then
                    if not playerESPLabels[player] then
                        -- Create ESP
                        local character = player.Character
                        local hrp = character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local gui = Instance.new("BillboardGui")
                            gui.Size = UDim2.new(4, 0, 2, 0)
                            gui.MaxDistance = CONFIG.ESP_DISTANCE
                            gui.Parent = hrp
                            
                            local label = Instance.new("TextLabel")
                            label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                            label.BackgroundTransparency = 0.5
                            label.TextColor3 = isGhost(player) and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                            label.TextSize = 14
                            label.Font = Enum.Font.GothamBold
                            label.Size = UDim2.new(1, 0, 1, 0)
                            label.Text = (isGhost(player) and "👻 " or "👤 ") .. player.Name
                            label.Parent = gui
                            
                            playerESPLabels[player] = gui
                        end
                    end
                else
                    if playerESPLabels[player] then
                        playerESPLabels[player]:Destroy()
                        playerESPLabels[player] = nil
                    end
                end
            end
        end
    else
        for p, gui in pairs(playerESPLabels) do
            gui:Destroy()
            playerESPLabels[p] = nil
        end
    end

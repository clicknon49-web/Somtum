-- ===== DIG FUNCTION =====
function Dig()
    if not UI.ToggleStates[1] then return end
    
    local char = player.Character
    if not char then return end
    
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then
        -- ถ้าตาย รอเกิดใหม่
        return
    end
    
    -- ส่งคำขอขุด
    if DigRequest then
        local success, err = pcall(function()
            DigRequest:FireServer()
        end)
        if not success then
            -- ถ้า RemoteEvent เปลี่ยนชื่อ ให้ลองหาใหม่
            DigRequest = GetRemote("DigRequest")
        end
    end
    
    -- อัพเดทสถิติ
    State.DigCount = State.DigCount + 1
    State.LastDigTime = tick()
    
    -- อัพเดท Progress Bar
    local progress = (State.DigCount % 10) / 10
    UI.UpdateProgress(progress, "⛏️ Digging... " .. State.DigCount)
    
    -- Anti-Ban: สุ่มเวลาขุด
    if Config.AntiBan then
        RandomWait(Config.DigCooldown * 0.8, Config.DigCooldown * 1.2)
    else
        wait(Config.DigCooldown)
    end
end

-- ===== AUTO SELL =====
function SellItems()
    if not UI.ToggleStates[2] then return end
    
    if SellRequest then
        local success, err = pcall(function()
            SellRequest:FireServer()
        end)
        if not success then
            SellRequest = GetRemote("SellRequest")
        end
    end
    wait(0.3)
end

-- ===== AUTO UPGRADE =====
function UpgradeType(upgradeType)
    if UpgradeOpen and UpgradeBuy then
        pcall(function()
            UpgradeOpen:FireServer()
            wait(0.2)
            UpgradeBuy:FireServer(upgradeType, 1)
            wait(0.2)
        end)
    end
end

function UpgradeAll()
    print("🔄 Upgrading all...")
    for _, upgradeType in ipairs({"Backpack", "Air", "Pickaxe"}) do
        UpgradeType(upgradeType)
        wait(0.3)
    end
end

-- ===== BUY PICKAXE =====
function BuyPickaxe(name)
    if not name then return end
    print("🪓 Buying: " .. name)
    
    if ShopOpen and ShopBuy and ShopEquip then
        pcall(function()
            ShopOpen:FireServer()
            wait(0.2)
            ShopBuy:FireServer(name)
            wait(0.2)
            ShopEquip:FireServer(name)
            wait(0.2)
        end)
        State.CurrentPickaxe = name
        UI.UpdateProgress(1, "✅ Equipped: " .. name)
        wait(0.5)
        print("✅ Equipped: " .. name)
    end
end

function SellAll()
    print("💰 Selling all...")
    for i = 1, 5 do
        if SellRequest then
            pcall(function()
                SellRequest:FireServer()
            end)
        end
        wait(0.15)
    end
end

-- =====================================================
-- 8. MAIN AUTO LOOP
-- =====================================================

local function AutoLoop()
    local lastSell = 0
    local lastUpgrade = 0
    local digCount = 0
    
    while true do
        -- ตรวจสอบตัวละคร
        local char = player.Character
        if not char then
            wait(1)
            char = player.Character or player.CharacterAdded:Wait()
            continue
        end
        
        local hum = char:FindFirstChild("Humanoid")
        if not hum or hum.Health <= 0 then
            wait(1)
            continue
        end
        
        -- ===== 1. AUTO DIG =====
        if UI.ToggleStates[1] then
            Dig()
        end
        
        -- ===== 2. AUTO SELL =====
        if UI.ToggleStates[2] and tick() - lastSell > Config.SellInterval then
            SellItems()
            lastSell = tick()
        end
        
        -- ===== 3. AUTO UPGRADE =====
        if UI.ToggleStates[3] and tick() - lastUpgrade > Config.UpgradeInterval then
            UpgradeAll()
            lastUpgrade = tick()
        end
        
        -- ===== 4. AUTO HEAL =====
        if Config.AutoHeal and hum then
            local healthPercent = (hum.Health / hum.MaxHealth) * 100
            if healthPercent < Config.HealThreshold then
                -- รอให้ฟื้น (ถ้ามีระบบฟื้น)
                wait(2)
            end
        end
        
        -- ===== 5. UPDATE STATS =====
        if digCount ~= State.DigCount then
            digCount = State.DigCount
            UI.UpdateStats({
                Digs = State.DigCount,
                Money = State.Stats.Money + math.random(100, 500),
                Crystals = State.Stats.Crystals + math.random(1, 3),
            })
        end
        
        wait(0.05)
    end
end


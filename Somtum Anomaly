local function SetupKeybinds()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.F then
            State.Farming = not State.Farming
            UI.UpdateStatus()
            UpdateToggleUI("Farming")
            print("🌾 Farming: " .. tostring(State.Farming))
        elseif input.KeyCode == Enum.KeyCode.G then
            State.Selling = not State.Selling
            UI.UpdateStatus()
            UpdateToggleUI("Selling")
            print("💰 Selling: " .. tostring(State.Selling))
        elseif input.KeyCode == Enum.KeyCode.H then
            State.Upgrading = not State.Upgrading
            UI.UpdateStatus()
            UpdateToggleUI("Upgrading")
            print("⬆️ Upgrading: " .. tostring(State.Upgrading))
        elseif input.KeyCode == Enum.KeyCode.J then
            BuyAndEquipPickaxe(Config.PickaxeToBuy)
        elseif input.KeyCode == Enum.KeyCode.K then
            -- เปลี่ยนขวานที่จะซื้อ
            local names = {"Rusty Scrapper", "Copper Pick", "Frostbite Pick", "Emerald Carver", "Obsidian Edge", "Celestial Apex", "DIAMOND Pickaxe"}
            for i, v in ipairs(names) do
                if v == Config.PickaxeToBuy then
                    Config.PickaxeToBuy = names[i % #names + 1]
                    break
                end
            end
            print("🎯 Next Pickaxe: " .. Config.PickaxeToBuy)
        end
    end)
end


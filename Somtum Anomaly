end

--// ========== 🔧 ระบบหาพื้นผิวน้ำแบบอัจฉริยะ ==========

--[[
  ปัญหา: Water.Top อาจอยู่สูงกว่าระดับน้ำจริง
  แก้ไข: หา Part ที่แทนระดับน้ำปัจจุบัน โดยลำดับความสำคัญ:
  1. Water.Top (ถ้ายังอยู่ในระยะที่เหมาะสม)
  2. Part อื่นในโฟลเดอร์ Water (Surface, Level, หรือ Part ที่มีชื่ออื่น)
  3. Raycast ลงจากตัวละครเพื่อหาน้ำจริง
  4. หา Part ที่มีชื่อ "Water" ทั้งหมดใน Workspace
--]]

local function GetWaterSurfaceSmart()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local charPos = hrp and hrp.Position or Vector3.new(0, 0, 0)

    -- วิธี 1: หาโฟลเดอร์ Water ใน Start
    local startFolder = Workspace:FindFirstChild("Start")
    if startFolder then
        local waterFolder = startFolder:FindFirstChild("Water")
        if waterFolder then
            -- ลองหา Top ก่อน
            local top = waterFolder:FindFirstChild("Top")
            if top and top:IsA("BasePart") then
                -- ถ้า Top อยู่ไม่สูงเกินไป (ไม่ห่างจากตัวละครมาก)
                if math.abs(top.Position.Y - charPos.Y) < 50 then
                    if Config.DebugMode then print("✅ ใช้ Water.Top | Y:", top.Position.Y) end
                    return top
                end
            end

            -- ลองหา Part อื่นในโฟลเดอร์ Water (Surface, Level, หรือ Part ที่ไม่ใช่ Top)
            for _, child in ipairs(waterFolder:GetChildren()) do
                if child:IsA("BasePart") and child.Name ~= "Top" then
                    if Config.DebugMode then print("✅ ใช้", child.Name, "ใน Water | Y:", child.Position.Y) end
                    return child
                end
            end

            -- ถ้า Water เองเป็น BasePart (บางแมพ Water เป็น Part ไม่ใช่ Folder)
            if waterFolder:IsA("BasePart") then
                if Config.DebugMode then print("✅ ใช้ Water (BasePart) | Y:", waterFolder.Position.Y) end
                return waterFolder
            end
        end
    end

    -- วิธี 2: Raycast ลงจากตัวละครเพื่อหาน้ำ (ใช้กรณีน้ำอยู่ต่ำ)
    if hrp then
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Whitelist
        rayParams.IgnoreWater = false

        -- เก็บ Part ที่อาจเป็นน้ำไว้กรอง
        local waterParts = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name:find("Water") or obj.Name:find("Lake") or obj.Name:find("River")) then
                table.insert(waterParts, obj)
            end
        end
        if #waterParts > 0 then
            rayParams.FilterDescendantsInstances = waterParts
            local rayResult = Workspace:Raycast(charPos + Vector3.new(0, 10, 0), Vector3.new(0, -100, 0), rayParams)
            if rayResult and rayResult.Instance then
                if Config.DebugMode then print("✅ Raycast เจอน้ำ:", rayResult.Instance.Name, "| Y:", rayResult.Position.Y) end
                return rayResult.Instance, rayResult.Position
            end
        end
    end

    -- วิธี 3: หา Part ที่ชื่อมี "Water" ใกล้ที่สุด
    local closest = nil
    local closestDist = Config.WaterSearchRange
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:find("Water") or obj.Name:find("Lake")) then
            local dist = (obj.Position - charPos).Magnitude
            if dist < closestDist then
                closestDist = dist
                closest = obj
            end
        end
    end
    if closest and Config.DebugMode then print("✅ ใช้", closest.Name, "ที่ใกล้ที่สุด | Y:", closest.Position.Y) end
    return closest
end

-- หา Bucket
local function GetCurrentBucket()
    local char = player.Character
    if not char then return nil end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool:FindFirstChild("WaterLevels") or tool.Name:find("Bucket")) then
            return tool
        end
    end
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool:FindFirstChild("WaterLevels") or tool.Name:find("Bucket")) then
                return tool
            end
        end
    end
    return nil
end

-- อ่านระดับน้ำ
local function GetWaterPercent(bucket)
    if not bucket then return 0, 0 end
    local waterLevels = bucket:FindFirstChild("WaterLevels")
    if not waterLevels then return 0, 0 end
    local filled, total = 0, 0
    for _, part in ipairs(waterLevels:GetChildren()) do
        if part:IsA("BasePart") then
            total += 1
            if part.Transparency < 1 then filled += 1 end
        end
    end
    if total == 0 then return 0, 0 end
    return math.floor((filled / total) * 100), total
end

--// ========== 🔧 แก้ไขการเก็บน้ำ ==========

local function CollectWaterRemote()
    local remote = GetBucketRemote()
    if not remote then
        if Config.DebugMode then warn("❌ ไม่พบ Remote VDT_Bucket.Used") end
        return false
    end

    local char = player.Character
    if not char then
        if Config.DebugMode then warn("❌ ไม่พบตัวละคร") end
        return false
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        if Config.DebugMode then warn("❌ ไม่พบ HumanoidRootPart") end
        return false
    end

    -- หาพื้นผิวน้ำแบบอัจฉริยะ
    local waterSurface, rayPos = GetWaterSurfaceSmart()
    if not waterSurface then
        if Config.DebugMode then warn("❌ ไม่พบพื้นผิวน้ำใดๆ") end
        return false
    end

    -- ตำแหน่งที่จะส่งไป: ใช้ตำแหน่งพื้นผิวน้ำจริง หรือตำแหน่ง Raycast
    local targetPos = rayPos or waterSurface.Position
    local hrpPos = hrp.Position

    -- ถ้าน้ำอยู่ต่ำกว่าตัวละครมาก ให้วาร์ปลงไปใกล้น้ำ (ป้องกันเก็บไม่ได้)
    if Config.AutoMoveToWater and math.abs(targetPos.Y - hrpPos.Y) > 10 then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            -- วาร์ปไปเหนือน้ำเล็กน้อย
            local newPos = Vector3.new(targetPos.X, targetPos.Y + 5, targetPos.Z)
            hrp.CFrame = CFrame.new(newPos)
            if Config.DebugMode then print("🚀 วาร์ปไปหาน้ำ:", tostring(newPos)) end
            task.wait(0.2)
            hrpPos = hrp.Position
        end
    end

    -- ปรับ args ให้ตรงกับระดับน้ำจริง
    local args = {
        [1] = waterSurface,
        [2] = hrpPos,                                    -- ตำแหน่งตัวละคร
        [3] = Vector3.new(0, -1, 0),                     -- Normal ลงล่าง
        [4] = Vector3.new(hrpPos.X, targetPos.Y - 1, hrpPos.Z)  -- ตำแหน่งที่น้ำจริง (ปรับ Y ให้ตรงน้ำ)
    }

    if Config.DebugMode then
        print("📤 ส่ง Remote | Water:", waterSurface.Name,
              "| HRP Y:", math.floor(hrpPos.Y),
              "| Water Y:", math.floor(targetPos.Y),
              "| Target Y:", math.floor(args[4].Y))
    end

    local success, err = pcall(function()
        remote:FireServer(unpack(args))
    end)

    if Config.DebugMode then
        if success then print("✅ เก็บน้ำสำเร็จ") else warn("❌ เก็บน้ำล้มเหลว:", err) end
    end
    return success
end

local function SellWaterRemote()
    local remote = GetSellRemote()
    local prompt = GetDrainPrompt()
    if not remote then
        if Config.DebugMode then warn("❌ ไม่พบ Remote VDT_Bucket.Poured") end
        return false
    end
    if not prompt then
        if Config.DebugMode then warn("❌ ไม่พบ Drain Prompt") end
        return false
    end
    local success, err = pcall(function()
        remote:FireServer(prompt)
    end)
    if Config.DebugMode then
        if success then print("✅ ขายน้ำสำเร็จ") else warn("❌ ขายน้ำล้มเหลว:", err) end
    end
    return success
end


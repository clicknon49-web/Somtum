    end
    
    -- Highlight active button
    local activeBtn = Sidebar:FindFirstChild(pageName .. "Btn")
    if activeBtn then
        activeBtn.BackgroundColor3 = Color3.fromRGB(40, 43, 53)
        activeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end


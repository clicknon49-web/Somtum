    label.Text = title
    label.TextColor3 = Color3.fromRGB(200, 200, 200)
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.Size = UDim2.new(0.7, 0, 1, 0)
    label.Position = UDim2.new(0, 10, 0, 0)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = frame
    
    local toggleBg = Instance.new("Frame")
    toggleBg.BackgroundColor3 = defaultValue and Color3.fromRGB(76, 175, 80) or Color3.fromRGB(80, 80, 80)
    toggleBg.Size = UDim2.new(0, 40, 0, 20)
    toggleBg.Position = UDim2.new(1, -50, 0.5, 0)
    toggleBg.AnchorPoint = Vector2.new(0, 0.5)
    toggleBg.Parent = frame
    
    local toggleCorner = Instance.new("UICorner")
    toggleCorner.CornerRadius = UDim.new(1, 0)
    toggleCorner.Parent = toggleBg
    
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.Text = ""
    toggleBtn.Size = UDim2.new(0, 16, 0, 16)
    toggleBtn.Position = defaultValue and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
    toggleBtn.AnchorPoint = Vector2.new(0, 0.5)
    toggleBtn.Parent = toggleBg
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(1, 0)
    btnCorner.Parent = toggleBtn
    
    return {
        Value = defaultValue,
        Frame = frame,
        Bg = toggleBg,
        Btn = toggleBtn,
        Label = label,
        Update = function(self, value)
            self.Value = value
            if value then
                self.Bg.BackgroundColor3 = Color3.fromRGB(76, 175, 80)
                TweenService:Create(self.Btn, TweenInfo.new(0.2), {Position = UDim2.new(1, -18, 0.5, 0)}):Play()
            else
                self.Bg.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
                TweenService:Create(self.Btn, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, 0)}):Play()
            end
        end
    }
end


    tracer.Thickness = 1.5
    tracer.Transparency = 0.7

    ESPObjects[model] = {
        Highlight = highlight,
        Billboard = billboard,
        NameLabel = nameLabel,
        InfoLabel = infoLabel,
        DistLabel = distLabel,
        Box = box,
        Tracer = tracer,
        Target = target
    }
end

local function updateESP()
    local myChar = player.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos = myHRP and myHRP.Position

    for model, data in pairs(ESPObjects) do
        if not model or not model.Parent then
            -- Cleanup
            if data.Highlight then data.Highlight:Destroy() end
            if data.Billboard then data.Billboard:Destroy() end
            if data.Box then data.Box:Remove() end
            if data.Tracer then data.Tracer:Remove() end
            ESPObjects[model] = nil
            continue
        end

        local isGhost = model:GetAttribute("IsGhost") == true
        local isRevealed = model:GetAttribute("Revealed") == true
        local isServed = model:GetAttribute("Served") == true
        local order = model:GetAttribute("Order") or "???"

        local shouldShow = getgenv().SomtumConfig.ESP.Enabled
        if getgenv().SomtumConfig.ESP.GhostOnly and not isGhost then
            shouldShow = false
        end

        if data.Highlight then
            data.Highlight.Enabled = shouldShow
            if isGhost then
                data.Highlight.FillColor = isRevealed and getgenv().SomtumConfig.ESP.RevealColor or getgenv().SomtumConfig.ESP.GhostColor
                data.Highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
            else
                data.Highlight.FillColor = getgenv().SomtumConfig.ESP.NormalColor
                data.Highlight.OutlineColor = Color3.fromRGB(0, 255, 100)
            end
        end

        if data.Billboard then
            data.Billboard.Enabled = shouldShow
        end

        if shouldShow then
            local nameText = isGhost and "👻 [ผี] " .. model.Name or "🧑 " .. model.Name
            if isServed then nameText = nameText .. " (เสิร์ฟแล้ว)" end
            data.NameLabel.Text = nameText
            data.NameLabel.TextColor3 = isGhost and getgenv().SomtumConfig.ESP.GhostColor or getgenv().SomtumConfig.ESP.NormalColor

            data.InfoLabel.Text = "🍽️ " .. order

            if myPos and data.Target then
                local dist = (myPos - data.Target.Position).Magnitude
                data.DistLabel.Text = string.format("%.1f ม.", dist)
            end
        end

        -- Drawing Box & Tracer
        if data.Target and data.Target.Parent then
            local pos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(data.Target.Position)

            if getgenv().SomtumConfig.ESP.BoxESP and shouldShow and onScreen then
                data.Box.Visible = true
                data.Box.Size = Vector2.new(50, 80)
                data.Box.Position = Vector2.new(pos.X - 25, pos.Y - 40)
                data.Box.Color = isGhost and getgenv().SomtumConfig.ESP.GhostColor or getgenv().SomtumConfig.ESP.NormalColor
            else
                data.Box.Visible = false
            end

            if getgenv().SomtumConfig.ESP.TracerESP and shouldShow and onScreen then
                data.Tracer.Visible = true
                data.Tracer.From = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y)
                data.Tracer.To = Vector2.new(pos.X, pos.Y)
                data.Tracer.Color = isGhost and getgenv().SomtumConfig.ESP.GhostColor or getgenv().SomtumConfig.ESP.NormalColor
            else
                data.Tracer.Visible = false
            end
        end
    end
end

local function scanAllGhosts()
    local ghostCount = 0
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name:match("Male%d+_Model") then
            createDrawingESP(obj)
            if obj:GetAttribute("IsGhost") == true then
                ghostCount = ghostCount + 1
            end
        end
    end
    StatusLabel.Text = "👻 พบผี: " .. ghostCount .. " ตัว | ESP: " .. (getgenv().SomtumConfig.ESP.Enabled and "ON" or "OFF")
    StatusLabel.TextColor3 = ghostCount > 0 and Color3.fromRGB(255, 100, 100) or Color3.fromRGB(100, 255, 100)
end

function clearESP()
    for model, data in pairs(ESPObjects) do
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        if data.Box then data.Box:Remove() end
        if data.Tracer then data.Tracer:Remove() end
    end
    ESPObjects = {}
    StatusLabel.Text = "🧹 ล้าง ESP แล้ว"
end


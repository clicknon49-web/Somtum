-- หา Bucket ที่ถืออยู่
local function GetCurrentBucket()
    local char = player.Character
    if not char then return nil end

    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then
            if tool:FindFirstChild("WaterLevels") or tool.Name:find("Bucket") then
                return tool
            end
        end
    end

    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                if tool:FindFirstChild("WaterLevels") or tool.Name:find("Bucket") then
                    return tool
                end
            end
        end
    end
    return nil
end

-- อ่านระดับน้ำปัจจุบัน
local function GetWaterPercent(bucket)
    if not bucket then return 0, 0 end
    local waterLevels = bucket:FindFirstChild("WaterLevels")
    if not waterLevels then return 0, 0 end

    local filled, total = 0, 0
    for _, part in ipairs(waterLevels:GetChildren()) do
        if part:IsA("BasePart") then
            total += 1
            if part.Transparency < 1 then
                filled += 1
            end
        end
    end
    if total == 0 then return 0, 0 end
    return math.floor((filled / total) * 100), total
end

-- เติมน้ำ 1 ระดับ
local function FillOneLevel(bucket)
    if not bucket then return end
    local waterLevels = bucket:FindFirstChild("WaterLevels")
    if not waterLevels then return end

    local emptyParts = {}
    for _, part in ipairs(waterLevels:GetChildren()) do
        if part:IsA("BasePart") and part.Transparency >= 1 then
            table.insert(emptyParts, part)
        end
    end

    table.sort(emptyParts, function(a, b)
        local na, nb = tonumber(a.Name), tonumber(b.Name)
        if na and nb then return na < nb end
        return a.Name < b.Name
    end)

    if #emptyParts > 0 then
        TweenService:Create(emptyParts[1], TweenInfo.new(0.2), {Transparency = 0}):Play()
    end
end

-- เติมน้ำเต็มถังทันที
local function FillInstant(bucket)
    if not bucket then return end
    local waterLevels = bucket:FindFirstChild("WaterLevels")
    if not waterLevels then return end

    for _, part in ipairs(waterLevels:GetChildren()) do
        if part:IsA("BasePart") then
            part.Transparency = 0
        end
    end
end

-- ล้างน้ำในถัง (หลังขาย)
local function ClearWater(bucket)
    if not bucket then return end
    local waterLevels = bucket:FindFirstChild("WaterLevels")
    if not waterLevels then return end

    for _, part in ipairs(waterLevels:GetChildren()) do
        if part:IsA("BasePart") then
            TweenService:Create(part, TweenInfo.new(0.3), {Transparency = 1}):Play()
        end
    end
end

-- หา RemoteEvent สำหรับขาย (พยายาม auto detect)
local function FindSellRemote()
    local rs = game:GetService("ReplicatedStorage")
    local remotes = {
        "SellEvent", "SellWater", "SellBucket", "WaterSold",
        "Sell", "CashEvent", "GiveMoney", "AddCash",
    }
    for _, name in ipairs(remotes) do
        local remote = rs:FindFirstChild(name)
        if remote and remote:IsA("RemoteEvent") then
            return remote
        end
    end
    return nil
end

--// ========== ระบบ Auto ==========

local function StartAutoCollect()
    if isAutoCollect then return end
    isAutoCollect = true

    collectThread = task.spawn(function()
        while isAutoCollect do
            local bucket = GetCurrentBucket()
            if bucket then
                local percent, max = GetWaterPercent(bucket)
                if percent < 100 then
                    if Config.InstantFill then
                        FillInstant(bucket)
                    else
                        FillOneLevel(bucket)
                    end
                end
            end
            task.wait(Config.AutoCollectInterval)
        end
    end)
end

local function StopAutoCollect()
    isAutoCollect = false
end

local function StartAutoSell()
    if isAutoSell then return end
    isAutoSell = true

    sellThread = task.spawn(function()
        while isAutoSell do
            local bucket = GetCurrentBucket()
            if bucket then
                local percent = GetWaterPercent(bucket)
                if percent >= Config.SellThreshold then
                    -- พยายามขายผ่าน remote ถ้ามี
                    local sellRemote = FindSellRemote()
                    if sellRemote then
                        pcall(function()
                            sellRemote:FireServer(bucket)
                        end)
                    end
                    -- ล้างน้ำ visual ไว้ก่อน (client-side)
                    ClearWater(bucket)
                end
            end
            task.wait(Config.AutoSellInterval)
        end
    end)
end

local function StopAutoSell()
    isAutoSell = false
end


getgenv().SnowDelta = getgenv().SnowDelta or {
    AutoFarm = false,
    AutoSell = false,
    AutoUpgradeBackpack = false,
    AutoUpgradeWarmth = false,
    AutoUpgradePickaxe = false,
    AutoUseRunes = true,
    AntiAFK = true,
    SafeMode = true,      -- หยุดทำงานชั่วคราวถ้ามีผู้เล่นใกล้ (ป้องกันรายงาน)
    Noclip = true,
    SellAtPercent = 85,   -- ขายเมื่อกระเป๋าใกล้เต็ม %
    FarmSpeed = 120,      -- ความเร็ว Tween (studs/s)
    ScanRadius = 600,
    SellPos = nil,        -- Vector3 จุดขาย (บันทึกผ่าน UI)
    ShopPos = nil,        -- Vector3 ร้านค้า (บันทึกผ่าน UI)
    PreferredOres = {"Gildrite","Voltite","Rimeveil","Nocturnite"},
    EquipBestPickaxe = true,
    MinSellInterval = 30, -- วินาทีขั้นต่ำระหว่างการขาย (ป้องกัน loop เร็วเกิน)

    if input.KeyCode == getgenv().SomtumConfig.ESP.Keybind then
        getgenv().SomtumConfig.ESP.Enabled = not getgenv().SomtumConfig.ESP.Enabled
        StatusLabel.Text = "ESP: " .. (getgenv().SomtumConfig.ESP.Enabled and "เปิด" or "ปิด")
    end
end)


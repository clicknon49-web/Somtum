if not game:IsLoaded() then game.Loaded:Wait() end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer

getgenv().SnowDelta = getgenv().SnowDelta or {
    AutoFarm = false,
    AutoSell = false,
    AutoUpgradeBackpack = false,
    AutoUpgradeWarmth = false,
    AutoUpgradePickaxe = false,
    AutoUseRunes = true,
    AntiAFK = true,
    SafeMode = true,
    Noclip = true,
    SellAtPercent = 85,
    FarmSpeed = 120,
    SellPos = nil,
    ShopPos = nil,
    PreferredOres = {"Gildrite","Voltite","Rimeveil","Nocturnite"},
    EquipBestPickaxe = true,
    MinSellInterval = 30,
}

local Config = getgenv().SnowDelta

-- ═══════════════════════════════════════════════════════════
-- 🔧 CORE SYSTEM
-- ═══════════════════════════════════════════════════════════
local character, humanoid, hrp
local function RefreshChar()
    character = player.Character or player.CharacterAdded:Wait()
    hrp = character:WaitForChild("HumanoidRootPart", 5)
    humanoid = character:WaitForChild("Humanoid", 5)
end
RefreshChar()
player.CharacterAdded:Connect(RefreshChar)

local function Notify(title, text, dur)
    dur = dur or 4
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = tostring(title), Text = tostring(text), Duration = dur
        })
    end)
end

local function TweenTo(pos, speed)
    if not hrp or not pos then return end
    local dist = (hrp.Position - pos).Magnitude
    if dist < 4 then return end
    local t = dist / (speed or Config.FarmSpeed)
    local tw = TweenService:Create(hrp, TweenInfo.new(t, Enum.EasingStyle.Linear), {
        CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
    })
    tw:Play()
    tw.Completed:Wait()
end

local function PressKey(key, hold)
    hold = hold or 0.12
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, key, false, game)
        task.wait(hold)
        VirtualInputManager:SendKeyEvent(false, key, false, game)
    end)
end

local function Click()
    pcall(function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
        task.wait(0.06)
        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
    end)
end

-- ═══════════════════════════════════════════════════════════
-- ⛏️ TOOLS & INVENTORY
-- ═══════════════════════════════════════════════════════════
local function GetTool(name)
    local bp = player:FindFirstChild("Backpack")
    if bp and bp:FindFirstChild(name) then return bp[name] end
    if character and character:FindFirstChild(name) then return character[name] end
    return nil
end

local function EquipTool(name)
    local tool = GetTool(name)
    if tool and humanoid then
        humanoid:EquipTool(tool)
        task.wait(0.4)
    end
end

local function GetBestPickaxe()
    local tier = {
        "The Terminus","Singularity","Voidreign","Nebular Throne","Eclipse Fang",
        "Astral Rend","Diamond Pickaxe","Shark Pickaxe","Celestial Apex","Tempest Pick",
        "Obsidian Edge","Emerald Carver","Frostbite Pick","Volcano Basalt","Titanium Spike",
        "Reinforced Steel","Hardened Iron","Copper Pick","Weathered Wood","Chipped Stone","Rusty Scrapper"
    }
    for _, name in ipairs(tier) do
        if GetTool(name) then return name end
    end
    return nil
end

local function EquipBestPickaxe()
    if not Config.EquipBestPickaxe then return end
    local best = GetBestPickaxe()
    if best then EquipTool(best) end
end

local function GetBackpackWeight()
    local bp = player:FindFirstChild("Backpack")
    return bp and #bp:GetChildren() or 0
end

local function ShouldSell()
    if not Config.AutoSell then return false end
    if not Config.SellPos then return false end
    local weight = GetBackpackWeight()
    local max = 12 -- ปรับตามกระเป๋าที่ใส่
    return (weight / max) * 100 >= Config.SellAtPercent
end

-- ═══════════════════════════════════════════════════════════
-- 🧱 ORE & FARMING
-- ═══════════════════════════════════════════════════════════
local function FindOres()
    local found = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Transparency == 0 then
            for _, oreName in ipairs(Config.PreferredOres) do
                if obj.Name:find(oreName) then
                    table.insert(found, obj)
                    break
                end
            end
        end
    end
    table.sort(found, function(a,b)
        return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
    end)
    return found
end

-- ═══════════════════════════════════════════════════════════
-- 💰 AUTO SELL
-- ═══════════════════════════════════════════════════════════
local lastSell = 0
local function AutoSell()
    if not Config.SellPos then
        Notify("⚠️ ขายของ", "ยังไม่ได้บันทึกจุดขาย! กด Save Sell Pos ใน UI", 5)
        return
    end
    if (tick() - lastSell) < Config.MinSellInterval then return end
    
    Notify("💰 ขายของ", "กำลังเดินไปขาย...", 3)
    Config.AutoFarm = false
    task.wait(0.5)
    TweenTo(Config.SellPos, 150)
    task.wait(1.2)
    
    for i = 1, 3 do
        PressKey(Enum.KeyCode.E, 0.15)
        task.wait(0.4)
    end
    task.wait(0.5)
    PressKey(Enum.KeyCode.Return, 0.15)
    task.wait(0.5)
    PressKey(Enum.KeyCode.Escape, 0.1)
    
    lastSell = tick()
    Notify("💰 ขายของ", "ขายเสร็จแล้ว! กลับไปฟาร์มต่อ...", 3)
    Config.AutoFarm = true
end

-- ═══════════════════════════════════════════════════════════
-- ⬆️ AUTO UPGRADE
-- ═══════════════════════════════════════════════════════════
local lastUpgrade = 0
local function AutoUpgrade()
    if not Config.ShopPos then return end
    if (tick() - lastUpgrade) < 60 then return end
    
    Config.AutoFarm = false
    task.wait(0.5)
    Notify("🛒 อัปเกรด", "กำลังไปร้านค้า...", 3)
    TweenTo(Config.ShopPos, 150)
    task.wait(1.5)
    
    PressKey(Enum.KeyCode.E, 0.2)
    task.wait(1)
    
    local buys = {}
    if Config.AutoUpgradeBackpack then table.insert(buys, {x=400, y=350}) end
    if Config.AutoUpgradeWarmth then table.insert(buys, {x=550, y=350}) end
    if Config.AutoUpgradePickaxe then table.insert(buys, {x=700, y=350}) end
    
    for _, b in ipairs(buys) do
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(b.x, b.y, 0, true, game, 1)
            task.wait(0.08)
            VirtualInputManager:SendMouseButtonEvent(b.x, b.y, 0, false, game, 1)
        end)
        task.wait(0.6)
    end
    
    PressKey(Enum.KeyCode.Escape, 0.15)
    lastUpgrade = tick()
    Notify("🛒 อัปเกรด", "เสร็จสิ้น! กลับไปฟาร์ม...", 3)
    Config.AutoFarm = true
end

-- ═══════════════════════════════════════════════════════════
-- 🔮 RUNES
-- ═══════════════════════════════════════════════════════════
local function AutoRunes()
    if not Config.AutoUseRunes then return end
    local runes = {"Haste Rune","Luck Rune","Warmth Rune","Excavator Rune","Fortune Rune","Colossus Rune"}
    for _, r in ipairs(runes) do
        if GetTool(r) then
            EquipTool(r)
            task.wait(0.3)
            Click()
            task.wait(0.3)
            EquipBestPickaxe()
            break
        end
    end
end

-- ═══════════════════════════════════════════════════════════
-- 🧠 MAIN LOOP
-- ═══════════════════════════════════════════════════════════
local farming = false
local function FarmLoop()
    if farming then return end
    farming = true
    while Config.AutoFarm do
        pcall(function()
            if not hrp or not humanoid then RefreshChar() return end
            
            if Config.SafeMode then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        if (p.Character.HumanoidRootPart.Position - hrp.Position).Magnitude < 25 then
                            Notify("🛡️ Safe Mode", "มีผู้เล่นใกล้ - หยุดชั่วคราว", 3)
                            task.wait(5)
                            return
                        end
                    end
                end
            end
            
            if ShouldSell() then AutoSell() return end
            
            AutoRunes()
            local ores = FindOres()
            if #ores > 0 then
                local target = ores[1]
                if target and target.Parent then
                    TweenTo(target.Position + Vector3.new(0, 4, 0), Config.FarmSpeed)
                    task.wait(0.3)
                    hrp.CFrame = CFrame.new(hrp.Position, target.Position)
                    task.wait(0.15)
                    EquipBestPickaxe()
                    task.wait(0.2)
                    for i = 1, 6 do
                        if not Config.AutoFarm then break end
                        Click()
                        task.wait(0.18)
                    end
                    task.wait(0.4)
                end
            else
                task.wait(1.5)
            end
        end)
        task.wait(0.1)
    end
    farming = false
end

-- ═══════════════════════════════════════════════════════════
-- 🛡️ ANTI AFK & NOCLIP
-- ═══════════════════════════════════════════════════════════
if Config.AntiAFK then
    local VirtualUser = game:GetService("VirtualUser")
    player.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

RunService.Stepped:Connect(function()
    if Config.Noclip and Config.AutoFarm then
        pcall(function()
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end)
    end
end)

-- ═══════════════════════════════════════════════════════════
-- 🖥️ BUILT-IN UI (NO LOADSTRING / NO ORION)
-- ═══════════════════════════════════════════════════════════
local function CreateUI()
    local SG = Instance.new("ScreenGui")
    SG.Name = "SnowDeltaUI"
    SG.ResetOnSpawn = false
    SG.Parent = game:GetService("CoreGui")
    
    local Main = Instance.new("Frame")
    Main.Name = "MainFrame"
    Main.Size = UDim2.new(0, 340, 0, 460)
    Main.Position = UDim2.new(0.05, 0, 0.15, 0)
    Main.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    Main.BorderSizePixel = 0
    Main.Active = true
    Main.Draggable = true
    Main.Parent = SG
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = Main
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 200, 255)
    stroke.Thickness = 2.5
    stroke.Parent = Main
    
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, 0, 0, 38)
    Title.BackgroundTransparency = 1
    Title.Text = "❄️ Delta - Snow Mining"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 18
    Title.Parent = Main
    
    local function MakeToggle(text, key, y)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.9, 0, 0, 34)
        btn.Position = UDim2.new(0.05, 0, 0, y)
        btn.BackgroundColor3 = Config[key] and Color3.fromRGB(0, 180, 90) or Color3.fromRGB(180, 50, 50)
        btn.Text = (Config[key] and "✅ " or "❌ ") .. text
        btn.TextColor3 = Color3.fromRGB(255,255,255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Parent = Main
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        
        btn.MouseButton1Click:Connect(function()
            Config[key] = not Config[key]
            btn.BackgroundColor3 = Config[key] and Color3.fromRGB(0, 180, 90) or Color3.fromRGB(180, 50, 50)
            btn.Text = (Config[key] and "✅ " or "❌ ") .. text
            if key == "AutoFarm" and Config[key] then
                task.spawn(FarmLoop)
            end
        end)
        return btn
    end
    
    local function MakeBtn(text, y, color, callback)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.9, 0, 0, 34)
        btn.Position = UDim2.new(0.05, 0, 0, y)
        btn.BackgroundColor3 = color
        btn.Text = text
        btn.TextColor3 = Color3.fromRGB(255,255,255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 14
        btn.Parent = Main
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
        btn.MouseButton1Click:Connect(callback)
        return btn
    end
    
    local y = 46
    MakeToggle("Auto Farm Ore", "AutoFarm", y); y += 40
    MakeToggle("Auto Sell", "AutoSell", y); y += 40
    MakeToggle("Upgrade Backpack", "AutoUpgradeBackpack", y); y += 40
    MakeToggle("Upgrade Warmth", "AutoUpgradeWarmth", y); y += 40
    MakeToggle("Upgrade Pickaxe", "AutoUpgradePickaxe", y); y += 40
    MakeToggle("Auto Use Runes", "AutoUseRunes", y); y += 40
    MakeToggle("Safe Mode", "SafeMode", y); y += 40
    MakeToggle("Noclip", "Noclip", y); y += 46
    
    MakeBtn("📍 Save Sell Pos", y, Color3.fromRGB(255, 160, 0), function()
        if hrp then
            Config.SellPos = hrp.Position
            Notify("บันทึกแล้ว", "จุดขาย: "..tostring(math.floor(Config.SellPos.X))..", "..tostring(math.floor(Config.SellPos.Z)), 4)
        end
    end); y += 40
    
    MakeBtn("📍 Save Shop Pos", y, Color3.fromRGB(255, 160, 0), function()
        if hrp then
            Config.ShopPos = hrp.Position
            Notify("บันทึกแล้ว", "ร้านค้า: "..tostring(math.floor(Config.ShopPos.X))..", "..tostring(math.floor(Config.ShopPos.Z)), 4)
        end
    end); y += 40
    
    MakeBtn("🛑 STOP ALL", y, Color3.fromRGB(200, 30, 30), function()
        Config.AutoFarm = false
        Config.AutoSell = false
        Notify("หยุดฉุกเฉิน", "ปิดทุกระบบแล้ว", 4)
    end)
    
    -- Toggle UI with RightShift
    local UIS = game:GetService("UserInputService")
    UIS.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.RightShift then
            Main.Visible = not Main.Visible
        end
    end)
    
    Notify("✅ Delta UI Ready", "กด RightShift เพื่อซ่อน/แสดง UI | อย่าลืม Save Sell Pos ก่อนเปิด Auto Sell!", 6)
end

task.spawn(CreateUI)
Notify("⏳ กำลังโหลด...", "สร้าง UI Built-in สำหรับ Delta...", 2)

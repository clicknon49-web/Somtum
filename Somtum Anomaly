local function AnimateToggle(btn, status, isOn, activeColor)
    local bg = isOn and activeColor or Color3.fromRGB(40, 40, 55)
    local st = isOn and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
    local stStroke = isOn and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)

    TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundColor3 = bg}):Play()
    TweenService:Create(status, TweenInfo.new(0.25), {BackgroundColor3 = st}):Play()
    TweenService:Create(statusGlow, TweenInfo.new(0.25), {Color = stStroke}):Play()
end


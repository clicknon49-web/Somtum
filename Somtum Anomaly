local function AddHover(btn, isActive)
    btn.MouseEnter:Connect(function()
        if not isActive() then
            TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(55, 55, 75)}):Play()
        end

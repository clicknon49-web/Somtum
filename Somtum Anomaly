-- =====================================================
-- 6. HELPER FUNCTIONS
-- =====================================================

function FormatNumber(n)
    if not n then return "0" end
    if n >= 1e9 then return string.format("%.2fB", n/1e9) end
    if n >= 1e6 then return string.format("%.2fM", n/1e6) end
    if n >= 1e3 then return string.format("%.1fK", n/1e3) end
    return tostring(math.floor(n))
end

function RandomWait(min, max)
    wait(min + math.random() * (max - min))
end

-- =====================================================
-- 7. CORE FUNCTIONS
-- =====================================================

function Dig()
    if not State.Farming then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return end
    
    if DigRequest then
        pcall(function()
            DigRequest:FireServer()
        end)
    end
    if Config.AntiBan then
        RandomWait(Config.DigCooldown * 0.7, Config.DigCooldown * 1.3)
    else
        wait(Config.DigCooldown)
    end
end

function SellItems()
    if not State.Selling then return end
    if SellRequest then
        pcall(function()
            SellRequest:FireServer()
        end)
    end
    wait(0.3)
end

function UpgradeType(upgradeType)
    if UpgradeOpen and UpgradeBuy then
        pcall(function()
            UpgradeOpen:FireServer()
            wait(0.2)
            UpgradeBuy:FireServer(upgradeType, 1)
            wait(0.2)
        end)
    end
end

function UpgradeAll()
    print("🔄 Upgrading all types...")
    for _, upgradeType in ipairs(Config.UpgradeTypes) do
        UpgradeType(upgradeType)
        wait(0.3)
    end
end

function BuyAndEquipPickaxe(name)
    if not name then return end
    print("🪓 Buying: " .. name)
    
    if ShopOpen and ShopBuy and ShopEquip then
        pcall(function()
            ShopOpen:FireServer()
            wait(0.2)
            ShopBuy:FireServer(name)
            wait(0.2)
            ShopEquip:FireServer(name)
            wait(0.2)
        end)
        State.CurrentPickaxe = name
        print("✅ Equipped: " .. name)
    end
end

function SellAll()
    print("💰 Selling all...")
    for i = 1, 5 do
        if SellRequest then
            pcall(function()
                SellRequest:FireServer()
            end)
        end
        wait(0.2)
    end
end

function GetBestPickaxe()
    -- ส่งคืนขวานที่ดีที่สุดที่มี (จาก Config)
    return Config.PickaxeToBuy
end

-- =====================================================
-- 8. AUTO LOOP (MAIN ENGINE)
-- =====================================================

local function AutoLoop()
    local lastSell = 0
    local lastUpgrade = 0
    
    while true do
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                
                -- FARM
                if State.Farming then
                    Dig()
                end
                
                -- SELL (with interval)
                if State.Selling and tick() - lastSell > Config.SellInterval then
                    SellItems()
                    lastSell = tick()
                end
                
                -- UPGRADE (with interval)
                if State.Upgrading and tick() - lastUpgrade > Config.UpgradeInterval then
                    local upgradeType = Config.UpgradeTypes[State.UpgradeIndex]
                    UpgradeType(upgradeType)
                    State.UpgradeIndex = State.UpgradeIndex + 1
                    if State.UpgradeIndex > #Config.UpgradeTypes then
                        State.UpgradeIndex = 1
                    end
                    lastUpgrade = tick()
                end
                
            end
        end
        
        wait(0.1)
    end
end


        Color3.fromRGB(46, 204, 113),
        Color3.fromRGB(241, 196, 15),
    }

    for i = 1, 3 do
        local btn = Instance.new("TextButton")
        btn.Parent = Main
        btn.Size = UDim2.new(0.28, -6, 0, 34)
        btn.Position = UDim2.new((i-1) * 0.333 + 0.025, 0, 0, ActionY)
        btn.BackgroundColor3 = ActionColors[i]
        btn.BackgroundTransparency = 0.25
        btn.Text = ActionLabels[i]
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 12
        btn.Font = Enum.Font.GothamBold
        btn.BorderSizePixel = 0

        local btnCorner = Instance.new("UICorner")
        btnCorner.Parent = btn
        btnCorner.CornerRadius = UDim.new(0, 8)

        local actions = {"Buy", "UpgradeAll", "SellAll"}
        btn.MouseButton1Click:Connect(function()
            if actions[i] == "Buy" then
                BuyPickaxe("DIAMOND Pickaxe")
            elseif actions[i] == "UpgradeAll" then
                UpgradeAll()
            elseif actions[i] == "SellAll" then
                SellAll()
            end
        end)
    end

    -- ===== PICKAXE LIST =====
    local PickaxeFrame = Instance.new("Frame")
    PickaxeFrame.Parent = Main
    PickaxeFrame.Size = UDim2.new(1, -20, 0, 180)
    PickaxeFrame.Position = UDim2.new(0, 10, 0, 170)
    PickaxeFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
    PickaxeFrame.BackgroundTransparency = 0.5
    PickaxeFrame.BorderSizePixel = 0
    PickaxeFrame.ClipsDescendants = true

    local pfCorner = Instance.new("UICorner")
    pfCorner.Parent = PickaxeFrame
    pfCorner.CornerRadius = UDim.new(0, 10)

    local PickaxeList = Instance.new("ScrollingFrame")
    PickaxeList.Parent = PickaxeFrame
    PickaxeList.Size = UDim2.new(1, 0, 1, 0)
    PickaxeList.BackgroundTransparency = 1
    PickaxeList.BorderSizePixel = 0
    PickaxeList.ScrollBarThickness = 3
    PickaxeList.CanvasSize = UDim2.new(0, 0, 0, 0)

    local PickaxeLayout = Instance.new("UIListLayout")
    PickaxeLayout.Parent = PickaxeList
    PickaxeLayout.Padding = UDim.new(0, 3)

    -- ===== PICKAXE DATA =====
    local PickaxeData = {
        {"Rusty Scrapper", "Common", 0, "🔧"},
        {"Chipped Stone", "Common", 500, "🪨"},
        {"Copper Pick", "Uncommon", 2500, "🪓"},
        {"Titanium Spike", "Uncommon", 8000, "⚡"},
        {"Frostbite Pick", "Rare", 25000, "❄️"},
        {"Emerald Carver", "Rare", 75000, "💚"},
        {"Obsidian Edge", "Epic", 250000, "🔮"},
        {"Celestial Apex", "Legendary", 1200000, "🌌"},
        {"DIAMOND Pickaxe", "Mythic", 4900000, "💎"},
    }

    local RarityColors = {
        Common = Color3.fromRGB(170, 170, 180),
        Uncommon = Color3.fromRGB(100, 200, 150),
        Rare = Color3.fromRGB(80, 180, 255),
        Epic = Color3.fromRGB(180, 100, 255),
        Legendary = Color3.fromRGB(255, 215, 0),
        Mythic = Color3.fromRGB(255, 100, 200),
    }

    local function FormatNumber(n)
        if n >= 1e6 then return string.format("%.1fM", n/1e6) end
        if n >= 1e3 then return string.format("%.1fK", n/1e3) end
        return tostring(n)
    end

    for _, data in ipairs(PickaxeData) do
        local name, rarity, price, icon = unpack(data)
        local btn = Instance.new("TextButton")
        btn.Parent = PickaxeList
        btn.Size = UDim2.new(1, -8, 0, 26)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        btn.BackgroundTransparency = 0.5
        btn.Text = icon .. " " .. name .. "  [" .. rarity .. "]  $" .. FormatNumber(price)
        btn.TextColor3 = RarityColors[rarity] or Color3.fromRGB(255, 255, 255)
        btn.TextSize = 11
        btn.Font = Enum.Font.GothamMedium
        btn.BorderSizePixel = 0
        btn.TextXAlignment = Enum.TextXAlignment.Left

        local btnCorner = Instance.new("UICorner")
        btnCorner.Parent = btn
        btnCorner.CornerRadius = UDim.new(0, 5)

        btn.MouseButton1Click:Connect(function()
            BuyPickaxe(name)
        end)

        PickaxeList.CanvasSize = UDim2.new(0, 0, 0, PickaxeLayout.AbsoluteContentSize.Y + 10)
    end

    PickaxeLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        PickaxeList.CanvasSize = UDim2.new(0, 0, 0, PickaxeLayout.AbsoluteContentSize.Y + 10)
    end)

    -- ===== KEY HINTS =====
    local HintBar = Instance.new("Frame")
    HintBar.Parent = Main
    HintBar.Size = UDim2.new(1, 0, 0, 24)
    HintBar.Position = UDim2.new(0, 0, 1, -24)
    HintBar.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    HintBar.BackgroundTransparency = 0.5
    HintBar.BorderSizePixel = 0

    local HintCorner = Instance.new("UICorner")
    HintCorner.Parent = HintBar
    HintCorner.CornerRadius = UDim.new(0, 14)

    local HintText = Instance.new("TextLabel")
    HintText.Parent = HintBar
    HintText.Size = UDim2.new(1, -10, 1, 0)
    HintText.Position = UDim2.new(0, 5, 0, 0)
    HintText.BackgroundTransparency = 1
    HintText.Text = "F:Farm  G:Sell  H:Upgrade  J:Buy  K:Cycle"
    HintText.TextColor3 = Color3.fromRGB(100, 100, 110)
    HintText.TextSize = 10
    HintText.Font = Enum.Font.GothamMedium
    HintText.TextXAlignment = Enum.TextXAlignment.Left

    -- ===== UPDATE STATUS =====
    function UpdateStatus()
        local status = "🟢 Idle"
        local active = {}
        if ToggleStates[1] then table.insert(active, "Farming") end
        if ToggleStates[2] then table.insert(active, "Selling") end
        if ToggleStates[3] then table.insert(active, "Upgrading") end
        
        if #active > 0 then
            status = "🟢 " .. table.concat(active, " + ")
        end
        StatusText.Text = "Status: " .. status
    end

    -- ===== FUNCTIONS =====
    function BuyPickaxe(name)
        print("🪓 Buying: " .. name)
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            local ShopOpen = remotes:FindFirstChild("ShopOpen")
            local ShopBuy = remotes:FindFirstChild("ShopBuy")
            local ShopEquip = remotes:FindFirstChild("ShopEquip")
            
            if ShopOpen and ShopBuy then
                pcall(function()
                    ShopOpen:FireServer()
                    wait(0.2)
                    ShopBuy:FireServer(name)
                    wait(0.2)
                    if ShopEquip then
                        ShopEquip:FireServer(name)
                    end
                    print("✅ Equipped: " .. name)
                end)
            else
                print("⚠️ Shop remotes not found!")
            end
        else
            print("⚠️ Remotes folder not found!")
        end
    end

    function UpgradeAll()
        print("🔄 Upgrading...")
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            local UpgradeOpen = remotes:FindFirstChild("UpgradeOpen")
            local UpgradeBuy = remotes:FindFirstChild("UpgradeBuy")
            
            if UpgradeOpen and UpgradeBuy then
                for _, upgradeType in ipairs({"Backpack", "Air", "Pickaxe"}) do
                    pcall(function()
                        UpgradeOpen:FireServer()
                        wait(0.2)
                        UpgradeBuy:FireServer(upgradeType, 1)
                        wait(0.2)
                    end)
                end
                print("✅ Upgraded all types!")
            else
                print("⚠️ Upgrade remotes not found!")
            end
        end
    end

    function SellAll()
        print("💰 Selling...")
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        if remotes then
            local SellRequest = remotes:FindFirstChild("SellRequest")
            if SellRequest then
                for i = 1, 5 do
                    pcall(function()
                        SellRequest:FireServer()
                    end)
                    wait(0.15)
                end
                print("✅ Sold items!")
            else
                print("⚠️ SellRequest not found!")
            end
        end
    end

    -- ===== KEYBOARD SHORTCUTS =====
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        
        if input.KeyCode == Enum.KeyCode.F then
            ToggleButtons[1]:Click()
        elseif input.KeyCode == Enum.KeyCode.G then
            ToggleButtons[2]:Click()
        elseif input.KeyCode == Enum.KeyCode.H then
            ToggleButtons[3]:Click()
        elseif input.KeyCode == Enum.KeyCode.J then
            BuyPickaxe("DIAMOND Pickaxe")
        elseif input.KeyCode == Enum.KeyCode.K then
            -- เปลี่ยนขวานที่ต้องการซื้อ
            local list = {"Rusty Scrapper", "Copper Pick", "Frostbite Pick", "Emerald Carver", "Obsidian Edge", "Celestial Apex", "DIAMOND Pickaxe"}
            if not nextTarget then nextTarget = 1 end
            nextTarget = nextTarget % #list + 1
            print("🎯 Next: " .. list[nextTarget])
        end
    end)

    -- ===== AUTO LOOP =====
    local function AutoLoop()
        local lastSell = 0
        local lastUpgrade = 0
        
        while true do
            if ToggleStates[1] then -- Farming
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then
                    local DigRequest = remotes:FindFirstChild("DigRequest")
                    if DigRequest then
                        pcall(function()
                            DigRequest:FireServer()
                        end)
                    end
                end
                wait(0.15)
            end
            
            if ToggleStates[2] and tick() - lastSell > 3 then -- Selling
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then
                    local SellRequest = remotes:FindFirstChild("SellRequest")
                    if SellRequest then
                        pcall(function()
                            SellRequest:FireServer()
                        end)
                    end
                end
                lastSell = tick()
            end
            
            if ToggleStates[3] and tick() - lastUpgrade > 5 then -- Upgrading
                UpgradeAll()
                lastUpgrade = tick()
            end
            
            wait(0.1)
        end
    end

    spawn(AutoLoop)

    -- ===== DRAG =====
    local dragging = false
    local dragStart, startPos

    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
        end
    end)

    Title.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    print("✅ UI Created Successfully!")
    return ScreenGui
end


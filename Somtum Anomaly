--//  AUTO COOK & SERVE (ใช้ Remote จริงจากเกม)
--// =====================================================
local cookingState = {
    Plate = "Empty",
    Ingredients = {},
    Progress = 0
}

local ingredientsOrder = {"Papaya", "Chilli", "Flavorings", "Vegetable"}
local currentIngredientIndex = 1

local function resetCooking()
    cookingState = {Plate = "Empty", Ingredients = {}, Progress = 0}
    currentIngredientIndex = 1
    StatusLabel.Text = "🔄 รีเซ็ตการทำอาหาร"
end

local function autoCookTick()
    if not getgenv().SomtumConfig.AutoCook.Enabled then return end

    if cookingState.Plate == "Empty" then
        -- เริ่มจากมะละกอ: เปิดเครื่องขูด -> ขูดเสร็จ -> ปิด
        if PapayaGrater_Open_RE then
            pcall(function() PapayaGrater_Open_RE:FireServer() end)
        end
        StatusLabel.Text = "🥭 ขูดมะละกอ..."
        wait(0.3)
        if PapayaGrater_Done_RE then
            pcall(function() PapayaGrater_Done_RE:FireServer() end)
        end
        wait(0.3)
        if PapayaGrater_Close_RE then
            pcall(function() PapayaGrater_Close_RE:FireServer() end)
        end
        cookingState.Plate = "Preparing"
        currentIngredientIndex = 2
        StatusLabel.Text = "🥭 ใส่มะละกอลงครก..."

    elseif cookingState.Plate == "Preparing" or cookingState.Plate == "Mixing" then
        local nextIng = ingredientsOrder[currentIngredientIndex]
        if nextIng and not cookingState.Ingredients[nextIng] then
            -- ใช้ MortarHold_RE สำหรับใส่วัตถุดิบ (ลองหลายรูปแบบ)
            if MortarHold_RE then
                pcall(function()
                    MortarHold_RE:FireServer(nextIng) -- ลองส่งชื่อวัตถุดิบ
                end)
            end
            cookingState.Ingredients[nextIng] = true
            currentIngredientIndex = currentIngredientIndex + 1
            StatusLabel.Text = "🌶️ ใส่ " .. nextIng .. "..."
        end
        cookingState.Progress = cookingState.Progress + 25
        if cookingState.Progress >= 100 then
            cookingState.Plate = "Done"
            StatusLabel.Text = "✅ ส้มตำพร้อมเสิร์ฟ!"
        end
    end
end

local function serveAllNormal()
    if not ForceServe_RE then
        StatusLabel.Text = "❌ ไม่พบ ForceServe_RE!"
        return
    end

    local myChar = player.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    local servedCount = 0
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name:match("Male%d+_Model") then
            local isGhost = obj:GetAttribute("IsGhost") == true
            local isServed = obj:GetAttribute("Served") == true

            if not isGhost and not isServed then
                local targetPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                if targetPart then
                    local dist = (myHRP.Position - targetPart.Position).Magnitude
                    if dist <= 20 then
                        pcall(function() ForceServe_RE:FireServer(obj) end)
                        servedCount = servedCount + 1
                        wait(0.3)
                    end
                end
            end
        end
    end
    StatusLabel.Text = "🍽️ เสิร์ฟคนปกติ: " .. servedCount .. " คน"
end

local function autoServeTick()
    if not getgenv().SomtumConfig.AutoServe.Enabled then return end
    if cookingState.Plate ~= "Done" then return end

    if not ForceServe_RE then return end

    local myChar = player.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name:match("Male%d+_Model") then
            local isGhost = obj:GetAttribute("IsGhost") == true
            local isServed = obj:GetAttribute("Served") == true

            local shouldServe = true
            if getgenv().SomtumConfig.AutoServe.ServeNormalOnly and isGhost then
                shouldServe = false
            end

            if shouldServe and not isServed then
                local targetPart = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                if targetPart then
                    local dist = (myHRP.Position - targetPart.Position).Magnitude
                    if dist <= getgenv().SomtumConfig.AutoServe.SafeDistance then
                        pcall(function() ForceServe_RE:FireServer(obj) end)
                        resetCooking() -- รีเซ็ตเพื่อทำจานใหม่
                        StatusLabel.Text = isGhost and "👻 เสิร์ฟผี! (เสี่ยง)" or "✅ Auto Serve สำเร็จ"
                        wait(getgenv().SomtumConfig.AutoCook.Delay)
                        break
                    end
                end
            end
        end
    end
end

